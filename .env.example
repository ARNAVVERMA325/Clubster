# ============================================================
# Backend (FastAPI) environment variables
# Copy this file to backend/.env and fill in real values.
# ============================================================

# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings > Database), used for
# migrations / tooling that talks to Postgres directly instead of via
# the Supabase client.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Anthropic API (used by POST /api/timetables/upload)
ANTHROPIC_API_KEY=your-anthropic-api-key

# App config
ENVIRONMENT=development
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
